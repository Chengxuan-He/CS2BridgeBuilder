<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BridgeBuilder</AssemblyName>
    <RootNamespace>BridgeBuilder</RootNamespace>
    <Version>0.3.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <CodePage>65001</CodePage>
  </PropertyGroup>


  <!-- Shared with the bridge exporter. Compiled in rather than referenced as an assembly: the shared
       types are internal, and a CS2 mod ships as a single DLL. -->
  <ItemGroup>
    <Compile Include="..\..\..\CS2ModShared\src\**\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\BridgeBuilder.svg" Link="BridgeBuilder.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\BridgeBuilderToolbar.svg" Link="BridgeBuilderToolbar.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\BridgeBuilderPack.svg" Link="BridgeBuilderPack.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\BridgeBuilderSearch.svg" Link="BridgeBuilderSearch.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\BridgeBuilderFilter.svg" Link="BridgeBuilderFilter.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\BridgeBuilderArrowDown.svg" Link="BridgeBuilderArrowDown.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="UI\BridgeBuilder.mjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="UI\BridgeBuilder.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Game"><HintPath>$(GameManagedDir)\Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.AssetPipeline"><HintPath>$(GameManagedDir)\Colossal.AssetPipeline.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><HintPath>$(GameManagedDir)\Colossal.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><HintPath>$(GameManagedDir)\Colossal.IO.AssetDatabase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><HintPath>$(GameManagedDir)\Colossal.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><HintPath>$(GameManagedDir)\Colossal.Logging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(GameManagedDir)/Colossal.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.UI"><HintPath>$(GameManagedDir)\Colossal.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><HintPath>$(GameManagedDir)\Colossal.UI.Binding.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GameManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(GameManagedDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime"><HintPath>$(GameManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><HintPath>$(GameManagedDir)\Unity.Entities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(GameManagedDir)\Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
