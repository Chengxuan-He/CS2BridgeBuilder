<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Colossal.AssetPipeline.Native">
      <HintPath>$(GameManagedDir)\Colossal.AssetPipeline.Native.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(GameManagedDir)\Unity.Collections.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
