    <Compile Include="../../../../src/BridgeBuilder/Bridges/Common/Movable/MovableChartPartition.cs" Link="MovableChartPartition.cs" />
    <Compile Include="../../../../src/BridgeBuilder/Bridges/Common/Movable/MovableRoadUv.cs" Link="MovableRoadUv.cs" />
    <Compile Include="../../../../src/BridgeBuilder/Bridges/Common/Movable/MovableUvDomains.cs" Link="MovableUvDomains.cs" />
