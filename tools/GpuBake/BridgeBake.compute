// Generation-only kernels. Output assets use native game material templates.
Texture2D<float4> _BaseColorMap, _NormalMap, _MaskMap, _WorldspaceAlbedo, _WorldspaceNormalMap, _WorldspaceMaskMap, _EmissiveColorMap, _ControlMask;
SamplerState sampler_BaseColorMap, sampler_NormalMap, sampler_MaskMap, sampler_WorldspaceAlbedo, sampler_WorldspaceNormalMap, sampler_WorldspaceMaskMap, sampler_EmissiveColorMap, sampler_ControlMask;
struct Pixel { float4 a,b,c,d,e; };
RWStructuredBuffer<uint2> Output;
RWStructuredBuffer<uint> Statistics;
RWStructuredBuffer<float2> Metadata;
int Channels, Size, Padding;
RWTexture2D<float4> AtlasColor, AtlasNormal, AtlasMask, AtlasControl, AtlasPosition;
float4 AtlasDomain, AtlasPixels, AtlasRect, PatchArea, PatchU, PatchV;
float4 PaintCenter, PaintRight, PaintUp, PaintForward, PaintHalf, PaintColor;
int AtlasTile, SkipAtlasControl;
float3 srgb(float3 x) { return lerp(12.92*x,1.055*pow(max(x,0),1.0/2.4)-.055,step(.0031308,x)); }
void store(uint index, Pixel p) {
 float4 values[5]={p.a,p.b,p.c,p.d,p.e};
 [loop]for(int channel=0;channel<Channels;channel++) {
  uint4 h=f32tof16(values[channel]);uint2 packed=h.xz | (h.yw<<16);
  Output[channel*Size*Size+index]=packed;
 }
}
[numthreads(8,8,1)] void Clear(uint3 id:SV_DispatchThreadID) {
 if(id.x>=Size || id.y>=Size)return;
 uint index=id.y*Size+id.x; Metadata[index]=0;
 // Transparent decal padding still participates in texture filtering. A zero
 // packed normal decodes to (-1,-1,0), not a neutral normal. Match the normal
 // written by Decal when normal influence is zero; flat pages can then collapse
 // to one shared constant texture instead of allocating a full page per mask.
 [loop]for(int channel=0;channel<Channels;channel++) Output[channel*Size*Size+index]=((Channels==5 && channel==2)||(Channels==3 && channel==1))?uint2(0x38003800,0x3c003c00):uint2(0,0);
}
// One thread reduces a bounded 16x16 block before touching shared summary counters.
// Never issue contended global atomics for every channel of every source pixel.
[numthreads(8,8,1)] void Reduce(uint3 id:SV_DispatchThreadID) {
 if(id.x*16>=Size || id.y*16>=Size)return;
 uint stats[23];
 [unroll]for(int k=0;k<23;k++)stats[k]=(k>=3 && (k&1))?0xffffffff:0;
 [loop]for(uint y=id.y*16;y<min(Size,id.y*16+16);y++)
 [loop]for(uint x=id.x*16;x<min(Size,id.x*16+16);x++) {
  uint index=y*Size+x;float2 meta=Metadata[index];
  stats[0]|=meta.y!=0;stats[1]|=meta.x<0;
  stats[2]=max(stats[2],asuint(max(0,meta.x)));
  if(Channels==5 && meta.y==0)continue;
  [loop]for(int c=0;c<Channels;c++) {
   uint2 packed=Output[c*Size*Size+index];uint k=3+c*4;
   stats[k]=min(stats[k],packed.x);stats[k+1]=max(stats[k+1],packed.x);
   stats[k+2]=min(stats[k+2],packed.y);stats[k+3]=max(stats[k+3],packed.y);
  }
 }
 [loop]for(int k=0;k<3+Channels*4;k++) {
  if(k>=3 && (k&1))InterlockedMin(Statistics[k],stats[k]);
  else InterlockedMax(Statistics[k],stats[k]);
 }
}
float4 PA,PB,PC, NA,NB,NC, TA,TB,TC, UA,UB,UC;
float4 ChartAB,ChartC,Rect;
float4x4 Frame,NormalFrame;
float WorldScale,Orientation;
float4 BaseColor, DecalValues, AlphaValues, Affect;
float4 CurveA,CurveB,CurveC,CurveD,MeshSize,CurveScale,TextureArea,Origin;
float Smoothing,Span;
float4 Center,Right,Forward;
struct Face { float2 a,b,c; };
StructuredBuffer<Face> Receivers;
int ReceiverCount;
float4x4 NormalRotation;
float3 norm(float3 v) { float len=length(v); return len>0.00001 ? v/len : 0; }
float3 unpack(float4 n) { float2 xy=float2(n.r*n.a,n.g)*2-1; return float3(xy,sqrt(1-min(1,dot(xy,xy)))); }
float smooth01(float t) { t=saturate(t); return t*t*(3-2*t); }
float smooth(float a,float b,float v) { return smooth01((v-a)/(b-a)); }
float3 weights(float2 p) {
 float2 a=ChartAB.xy,b=ChartAB.zw,c=ChartC.xy, ab=b-a, ac=c-a,q=p-a;
 float den=ab.x*ac.y-ab.y*ac.x;
 float v=(q.x*ac.y-q.y*ac.x)/den, w=(ab.x*q.y-ab.y*q.x)/den;
 if(v>=0 && w>=0 && v+w<=1) return float3(1-v-w,v,w);
 float best=3.402823e38; float3 result=0;
 float2 starts[3]={a,b,c},ends[3]={b,c,a};
 float3 basis[3]={float3(1,0,0),float3(0,1,0),float3(0,0,1)};
 [unroll]for(int i=0;i<3;i++) { float2 delta=ends[i]-starts[i]; float t=saturate(dot(p-starts[i],delta)/dot(delta,delta)); float2 d=p-starts[i]-delta*t; float distance=dot(d,d); if(distance<best){best=distance; result=lerp(basis[i],basis[(i+1)%3],t);} }
 return result;
}
[numthreads(8,8,1)] void Road(uint3 id:SV_DispatchThreadID) {
 if(id.x>=Rect.z || id.y>=Rect.w)return;
 float3 w=weights(float2(id.xy)-Padding);
 float3 p=PA.xyz*w.x+PB.xyz*w.y+PC.xyz*w.z;
 float3 n=norm(NA.xyz*w.x+NB.xyz*w.y+NC.xyz*w.z);
 float3 t=TA.xyz*w.x+TB.xyz*w.y+TC.xyz*w.z;
 t=norm(t-n*dot(n,t));
 float2 uv=UA.xy*w.x+UB.xy*w.y+UC.xy*w.z;
 float2 world=mul(Frame,float4(p,1)).xz*WorldScale;
 float4 mask=_MaskMap.SampleLevel(sampler_MaskMap,uv,0);
 float4 wm=_WorldspaceMaskMap.SampleLevel(sampler_WorldspaceMaskMap,world,0);
 n=norm(mul((float3x3)NormalFrame,n)); t=norm(mul((float3x3)Frame,t));
 float3 bitangent=cross(n,t)*(TA.w*Orientation);
 float3 wn=unpack(_WorldspaceNormalMap.SampleLevel(sampler_WorldspaceNormalMap,world,0));
 float3 bn=unpack(_NormalMap.SampleLevel(sampler_NormalMap,uv,0));
 Pixel o;
 o.a=lerp(_BaseColorMap.SampleLevel(sampler_BaseColorMap,uv,0),_WorldspaceAlbedo.SampleLevel(sampler_WorldspaceAlbedo,world,0),mask.b);
 o.b=float4(lerp(mask.rg,wm.rg,mask.b),0,lerp(mask.a,wm.a,mask.b));
 float3 blended=lerp(bn,float3(dot(wn.xy,t.xz),dot(wn.xy,bitangent.xz),wn.z),mask.b);
 float normalLength=length(blended);
 o.c=float4(blended.xy/normalLength*.5+.5,1,abs(1-normalLength));
 if(normalLength==0 || !isfinite(normalLength)) o.c.w=-1;
 o.d=_EmissiveColorMap.SampleLevel(sampler_EmissiveColorMap,uv,0);
 o.e=_ControlMask.SampleLevel(sampler_ControlMask,uv,0);
 Metadata[(id.y+(uint)Rect.y)*Size+id.x+(uint)Rect.x]=float2(o.c.w,1);
 o.c.zw=1;
 store((id.y+(uint)Rect.y)*Size+id.x+(uint)Rect.x,o);
}
float4 bezier(float t){float s=1-t;return CurveA*s*s*s+CurveB*3*s*s*t+CurveC*3*s*t*t+CurveD*t*t*t;}
float3 derivative(float t){float s=1-t;return (CurveB-CurveA).xyz*3*s*s+(CurveC-CurveB).xyz*6*s*t+(CurveD-CurveC).xyz*3*t*t;}
float2 coordinates(float3 p,float4 center,float2 forward){float2 d=p.xz-center.xz;return float2(dot(float2(forward.y,-forward.x),d)/MeshSize.x+.5,dot(forward,d)/MeshSize.z+center.w);}
float opacity(float value,float height,float endFade){return 1-pow(clamp(1-value*height,(1-endFade)*.001,1),endFade);}
[numthreads(8,8,1)] void Decal(uint3 id:SV_DispatchThreadID) {
 if(id.x>=Size || id.y>=Size)return;
 Pixel o=(Pixel)0; uint index=id.y*Size+id.x; store(index,o);
 float3 position=Center.xyz+Right.xyz*(((id.x+.5)/Size-.5)*Span)+Forward.xyz*(((id.y+.5)/Size-.5)*Span);
 float2 projected=float2(dot(position,Right.xyz),dot(position,Forward.xyz));
 bool covered=false;
 [loop]for(int face=0;face<ReceiverCount;face++) {
  Face f=Receivers[face];float2 ab=f.b-f.a,ac=f.c-f.a,q=projected-f.a;
  float den=ab.x*ac.y-ab.y*ac.x;
  float v=(q.x*ac.y-q.y*ac.x)/den,w=(ab.x*q.y-ab.y*q.x)/den;
  if(v>=0 && w>=0 && v+w<=1){covered=true;break;}
 }
 if(!covered)return;
 float3 p=position-Origin.xyz;
 float4 center; float3 forward; float2 uv;
 if(CurveA.x==CurveD.x && CurveA.z==CurveD.z){
  center=CurveA;forward=float3(0,0,1);float3 d=p-CurveA.xyz;float longitudinal=d.z/MeshSize.z;
  uv=float2(d.x/MeshSize.x+.5,longitudinal+.5+sign(longitudinal)*.5);
 } else {
  float lo=0,hi=1,t=.5;float2 left=CurveA.xz,right=CurveD.xz;
  [unroll]for(int i=0;i<6;i++){
   float2 chord=right-left;float factor=clamp(dot(p.xz-left,chord)/dot(chord,chord),.1,.9);
   t=lerp(lo,hi,factor);float4 at=bezier(t);float3 d=derivative(t);
   if(dot(d.xz,p.xz-at.xz)<=0){hi=t;right=at.xz;}else{lo=t;left=at.xz;}
  }
  center=bezier(t);forward=norm(derivative(t));
  float2 middle=coordinates(p,center,normalize(forward.xz));
  float2 end=coordinates(p,CurveD,normalize(CurveD.xz-CurveC.xz));
  float2 start=coordinates(p,CurveA,normalize(CurveB.xz-CurveA.xz));
  float ew=min(smooth(CurveB.w,CurveC.w,middle.y),smooth(lerp(CurveC.w,CurveD.w,.7),CurveD.w,end.y));
  float sw=min(smooth(CurveC.w,CurveB.w,middle.y),smooth(lerp(CurveB.w,CurveA.w,.7),CurveA.w,start.y));
  uv=lerp(lerp(middle,end,ew),start,sw);
 }
 float progress=uv.y/CurveD.w;
 float side=(uv.x-.5)/lerp(CurveScale.x,CurveScale.z,saturate(progress));
 float vertical=(p.y-center.y-MeshSize.w)/MeshSize.y;
 float margin=(.5-abs(progress-.5))*MeshSize.z*CurveD.w;
 if(.5-abs(side)<0 || .5-abs(vertical)<0 || margin+Smoothing<0)return;
 float endFade=Smoothing==0 ? 1 : smooth01((margin+Smoothing)/(2*Smoothing));
 float height=smooth01((.5-abs(vertical))*4);
 uv=float2(lerp(TextureArea.x,TextureArea.z,side+.5),lerp(TextureArea.y,TextureArea.w,uv.y));
 float4 albedo=_BaseColorMap.SampleLevel(sampler_BaseColorMap,uv,0);
 float4 mask=_MaskMap.SampleLevel(sampler_MaskMap,uv,0);
 float3 normal=unpack(_NormalMap.SampleLevel(sampler_NormalMap,uv,0));
 float na=lerp(albedo.a,mask.b,AlphaValues.x)*DecalValues.z;
 float ma=lerp(albedo.a,mask.g,AlphaValues.y)*DecalValues.w;
 float ao=Affect.x!=0?opacity(albedo.a*BaseColor.a,height,endFade):0;
 float no=Affect.y!=0?opacity(na,height,endFade):0;
 float mo=Affect.z!=0?opacity(ma,height,endFade):0;
 float so=Affect.w!=0?opacity(ma,height,endFade):0;
 float3 encodedNormal=float3(0,0,1);
 float invalid=0;
 if(no!=0){
  float3 f=norm(float3(forward.x,0,forward.z));
  float3 r=float3(f.z,0,-f.x);
  float3 local=mul((float3x3)NormalRotation,r*normal.x+f*normal.y+float3(0,1,0)*normal.z);
  encodedNormal=local.xzy;
  float n2=dot(encodedNormal,encodedNormal);
  if(!isfinite(n2) || n2==0 || encodedNormal.z<0)invalid=1;
  encodedNormal=norm(encodedNormal);
 }
 o.a=float4(albedo.rgb*BaseColor.rgb,ao);
 o.b=float4(encodedNormal.xy*.5+.5,1,1);
 o.c=float4(mask.r*DecalValues.x,Affect.z!=0?mo:Affect.w!=0?so:0,no,mask.a*DecalValues.y);
 o.d=float4((ao!=0 || no!=0 || mo!=0 || so!=0)?1:0,invalid,0,0);
 Metadata[index]=float2(o.d.y!=0?-1:0,o.d.x);
 store(index,o);
}

// A zero blue channel everywhere proves that filtered samples cannot activate
// world-space blending. Read only a one-word decision back to the CPU.
[numthreads(8,8,1)] void ReuseMask(uint3 id:SV_DispatchThreadID) {
 uint width,height; _MaskMap.GetDimensions(width,height);
 uint mixed=0;
 [loop]for(uint y=id.y*16;y<min(height,id.y*16+16);y++)
 [loop]for(uint x=id.x*16;x<min(width,id.x*16+16);x++)
  mixed |= _MaskMap.Load(int3(x,y,0)).b != 0;
 if(mixed)InterlockedOr(Statistics[0],mixed);
}

StructuredBuffer<float3> PreviewPositions;
StructuredBuffer<uint> PreviewBones, PreviewIndices;
StructuredBuffer<float4x4> PreviewSkin;
RWStructuredBuffer<uint> PreviewExtents;
int PreviewIndexCount;
float4x4 PreviewView;
uint orderedFloat(float v) { uint b=asuint(v); return (b&0x80000000)?~b:(b^0x80000000); }
// Appearance is rasterized, never tessellated at paint or repeat boundaries.
Texture2D<float4> MipSource;
SamplerState sampler_MipSource;
float4 NativeCrop;
int NativeCropSrgb;
int NativeCropTriangle,NativeCropNormal;
float4 NativeCropA,NativeCropB,NativeCropC;
float4 NativeCropDestination,NativeCropOrigin,NativeCropStepX,NativeCropStepY;
float4 nativeCropSample(float2 q) {
 bool reverse=NativeCropTriangle!=0 && q.x+q.y>1;
 if(reverse)q=1-q;
 float2 uv=NativeCropTriangle!=0 ? NativeCropA.xy+q.x*(NativeCropB.xy-NativeCropA.xy)+q.y*(NativeCropC.xy-NativeCropA.xy)
  : NativeCrop.xy+q*NativeCrop.zw;
 float4 color=MipSource.SampleLevel(sampler_MipSource,uv,0);
 // The second half is a 180-degree image rotation. Rotate the tangent-space
 // normal too, decoding both native RG and AG normal-map representations.
 if(reverse && NativeCropNormal!=0)color=float4(1-color.r*color.a,1-color.g,color.b,1);
 if(NativeCropSrgb!=0)color.rgb=srgb(color.rgb);
 return color;
}
[numthreads(8,8,1)] void CropNative(uint3 id:SV_DispatchThreadID) {
 uint width,height;AtlasColor.GetDimensions(width,height);
 if(any(id.xy>=uint2(width,height)))return;
 AtlasColor[id.xy]=nativeCropSample((float2(id.xy)+.5)/float2(width,height));
}
[numthreads(8,8,1)] void CropNativeAtlas(uint3 id:SV_DispatchThreadID) {
 if(any(id.xy>=uint2(NativeCropDestination.zw)))return;
 float2 q=NativeCropOrigin.xy+(id.x+.5)*NativeCropStepX.xy+(id.y+.5)*NativeCropStepY.xy;
 AtlasColor[uint2(NativeCropDestination.xy)+id.xy]=nativeCropSample(frac(q));
}
RWStructuredBuffer<uint4> CompressedAtlas;
// BC7 mode 6: RGBA 7-bit endpoints, one p-bit per endpoint, 4-bit indices.
// Native virtual-texture stacks use BC7; BC3 blocks are not interchangeable.
void putBits(inout uint4 block,inout uint cursor,uint value,uint count) {
 uint word=cursor/32,shift=cursor%32;
 block[word]|=value<<shift;
 if(shift+count>32)block[word+1]|=value>>(32-shift);
 cursor+=count;
}
uint4 quantize7(float4 color,out uint pbit) {
 float best=1e30;uint4 result=0;pbit=0;
 [unroll]for(uint p=0;p<2;p++) {
  uint4 q=(uint4)clamp(round((color-p)*.5),0,127);
  float4 d=float4(q*2+p)-color;float error=dot(d,d);
  if(error<best){best=error;result=q;pbit=p;}
 }
 return result;
}
static const uint weights7[16]={0,4,9,13,17,21,26,30,34,38,43,47,51,55,60,64};
[numthreads(8,8,1)] void CompressAtlas(uint3 id:SV_DispatchThreadID) {
 uint width,height;MipSource.GetDimensions(width,height);
 uint blocks=(width+3)/4;if(id.x>=blocks || id.y>=(height+3)/4)return;
 float4 pixels[16];
 [unroll]for(uint k=0;k<16;k++)
  pixels[k]=round(saturate(MipSource.Load(int3(min(id.xy*4+uint2(k%4,k/4),uint2(width-1,height-1)),0)))*255);
 float4 ends[2];ends[0]=pixels[0];ends[1]=pixels[0];
 [unroll]for(uint iteration=0;iteration<2;iteration++) {
  float distance=-1;
  [unroll]for(uint i=0;i<16;i++) {
   float4 delta=pixels[i]-ends[iteration];float error=dot(delta,delta);
   if(error>distance){distance=error;ends[1-iteration]=pixels[i];}
  }
 }
 uint p0,p1;uint4 e0=quantize7(ends[0],p0),e1=quantize7(ends[1],p1);
 uint indices[16];
 [unroll]for(uint i=0;i<16;i++) {
  float distance=1e30;uint best=0;
  [unroll]for(uint j=0;j<16;j++) {
   float4 c=floor(((64-weights7[j])*float4(e0*2+p0)+weights7[j]*float4(e1*2+p1)+32)/64);
   float4 delta=pixels[i]-c;float error=dot(delta,delta);
   if(error<distance){distance=error;best=j;}
  }
  indices[i]=best;
 }
 // The anchor omits its high bit; reverse endpoint order when required.
 if(indices[0]>=8) {
  uint4 e=e0;e0=e1;e1=e;uint p=p0;p0=p1;p1=p;
  [unroll]for(uint i=0;i<16;i++)indices[i]=15-indices[i];
 }
 uint4 block=0;uint cursor=0;putBits(block,cursor,64,7);
 [unroll]for(uint c=0;c<4;c++){putBits(block,cursor,e0[c],7);putBits(block,cursor,e1[c],7);}
 putBits(block,cursor,p0,1);putBits(block,cursor,p1,1);
 [unroll]for(uint i=0;i<16;i++)putBits(block,cursor,indices[i],i==0?3:4);
 CompressedAtlas[id.y*blocks+id.x]=block;
}
RWTexture2D<float4> MipTarget;
int MipChannel;
int2 MipExtent;
float3 linearColor(float3 x) {return lerp(x/12.92,pow((x+.055)/1.055,2.4),step(.04045,x));}
[numthreads(8,8,1)] void AtlasMip(uint3 id:SV_DispatchThreadID) {
 if(any(id.xy>=uint2(MipExtent)))return;
 uint sourceWidth,sourceHeight;MipSource.GetDimensions(sourceWidth,sourceHeight);
 float4 sum=0;
 [unroll]for(int y=0;y<2;y++)[unroll]for(int x=0;x<2;x++) {
  float4 v=MipSource.Load(int3(min(id.xy*2+uint2(x,y),uint2(sourceWidth-1,sourceHeight-1)),0));
  if(MipChannel==0)v.rgb=linearColor(v.rgb);
  if(MipChannel==1)v.xyz=unpack(v);
  sum+=v;
 }
 sum*=.25;
 if(MipChannel==0)sum.rgb=srgb(sum.rgb);
 if(MipChannel==1)sum=float4(normalize(sum.xyz).xy*.5+.5,1,1);
 MipTarget[id.xy]=sum;
}
float4 ChartOrigin, ChartU, ChartV, PaintRect;
int OriginalRoad;
StructuredBuffer<float4> AsphaltBounds;
RWStructuredBuffer<uint> AsphaltOnly;
groupshared uint NonAsphalt;
[numthreads(64,1,1)] void ClassifyAsphalt(uint3 group:SV_GroupID,uint lane:SV_GroupIndex) {
 if(lane==0)NonAsphalt=0;
 GroupMemoryBarrierWithGroupSync();
 uint w,h; _MaskMap.GetDimensions(w,h);
 float4 bounds=AsphaltBounds[group.x];
 // Include the complete bilinear footprint, not just triangle vertices or centres.
 int2 first=int2(floor(bounds.xy*float2(w,h)-.5));
 int2 last=int2(ceil(bounds.zw*float2(w,h)-.5));
 uint2 extent=min(uint2(max(1,last-first+1)),uint2(w,h));
 for(uint i=lane;i<extent.x*extent.y;i+=64) {
  int2 p=first+int2(i%extent.x,i/extent.x);
  p=(p%int2(w,h)+int2(w,h))%int2(w,h);
  if(_MaskMap.Load(int3(p,0)).b<1.0)InterlockedOr(NonAsphalt,1);
 }
 GroupMemoryBarrierWithGroupSync();
 if(lane==0)AsphaltOnly[group.x]=1-NonAsphalt;
}
int ReplaceRoad, RoadBandCount, RoadBandRows;
StructuredBuffer<float4> AsphaltTriangles;
int AsphaltWrapU, AsphaltWrapV;
int addressAsphalt(int p,int size,int mode) {
 if(mode==1)return clamp(p,0,size-1);
 if(mode==3)return clamp(p<0?-1-p:p,0,size-1);
 if(mode==2) {p=(p%(2*size)+2*size)%(2*size);return p<size?p:2*size-1-p;}
 return (p%size+size)%size;
}
// A texel contributes through a bilinear tent of radius one texel. Test that
// box against the actual UV triangle, not the empty corners of its bounds.
bool asphaltFootprint(float2 a,float2 b,float2 c,float2 centre) {
 a-=centre;b-=centre;c-=centre;
 if(any(min(a,min(b,c))>1) || any(max(a,max(b,c))<-1))return false;
 float2 edges[3]={b-a,c-b,a-c};
 [unroll]for(int e=0;e<3;e++) {
  float2 n=float2(-edges[e].y,edges[e].x);
  float radius=abs(n.x)+abs(n.y);
  float3 projection=float3(dot(a,n),dot(b,n),dot(c,n));
  if(min(projection.x,min(projection.y,projection.z))>radius ||
     max(projection.x,max(projection.y,projection.z))<-radius)return false;
 }
 return true;
}
[numthreads(64,1,1)] void ClassifyAsphaltTriangles(uint3 group:SV_GroupID,uint lane:SV_GroupIndex) {
 if(lane==0)NonAsphalt=0;
 GroupMemoryBarrierWithGroupSync();
 uint w,h;_MaskMap.GetDimensions(w,h);
 float2 dimensions=float2(w,h);
 float2 a=AsphaltTriangles[group.x*3].xy*dimensions;
 float2 b=AsphaltTriangles[group.x*3+1].xy*dimensions;
 float2 c=AsphaltTriangles[group.x*3+2].xy*dimensions;
 int2 first=int2(floor(min(a,min(b,c))-.5));
 int2 last=int2(ceil(max(a,max(b,c))-.5));
 // Excessive repeated UV ranges use a conservative whole-texture test instead
 // of an unbounded dispatch. This can reject a tile, never erase a mixed layer.
 bool whole=any(last-first>int2(w,h)*4);
 if(whole){first=0;last=int2(w,h)-1;}
 uint2 extent=uint2(max(1,last-first+1));
 for(uint i=lane;i<extent.x*extent.y;i+=64) {
  int2 p=first+int2(i%extent.x,i/extent.x);
  if(!whole && !asphaltFootprint(a,b,c,float2(p)+.5))continue;
  int2 sample=int2(addressAsphalt(p.x,w,AsphaltWrapU),addressAsphalt(p.y,h,AsphaltWrapV));
  if(_MaskMap.Load(int3(sample,0)).b<1.0)InterlockedOr(NonAsphalt,1);
 }
 GroupMemoryBarrierWithGroupSync();
 if(lane==0)AsphaltOnly[group.x]=1-NonAsphalt;
}
float4 RoadU, RoadV;
StructuredBuffer<float4> RoadBands;
Texture2D<float4> _Road_BaseColorMap, _Road_NormalMap, _Road_MaskMap;
SamplerState sampler_Road_BaseColorMap, sampler_Road_NormalMap, sampler_Road_MaskMap;
float4 NativeValues;
float3 chartPosition(float2 pixel) {
 return ChartOrigin.xyz+ChartU.xyz*((pixel.x+.5-AtlasPixels.y)/AtlasPixels.x)+ChartV.xyz*((pixel.y+.5-AtlasPixels.y)/AtlasPixels.z);
}
[numthreads(8,8,1)] void SurfaceAtlas(uint3 id:SV_DispatchThreadID) {
 if(any(id.xy>=uint2(AtlasRect.zw)))return;
 uint2 pixel=id.xy+uint2(AtlasRect.xy);
 float3 position=chartPosition(id.xy);
 float2 uv=float2(dot(float4(position,1),PatchU),dot(float4(position,1),PatchV));
 if(OriginalRoad==0)uv=PatchArea.xy+frac(uv)*PatchArea.zw;
 uint width,height;_BaseColorMap.GetDimensions(width,height);
 float2 dx=float2(dot(ChartU.xyz,PatchU.xyz),dot(ChartU.xyz,PatchV.xyz))*PatchArea.zw*float2(width,height)/AtlasPixels.x;
 float2 dy=float2(dot(ChartV.xyz,PatchU.xyz),dot(ChartV.xyz,PatchV.xyz))*PatchArea.zw*float2(width,height)/AtlasPixels.z;
 float mip=max(0,log2(max(1,max(length(dx),length(dy)))));
 float4 c=_BaseColorMap.SampleLevel(sampler_BaseColorMap,uv,mip);
 float3 n=unpack(_NormalMap.SampleLevel(sampler_NormalMap,uv,mip));
 float3 normal=normalize(cross(ChartU.xyz,ChartV.xyz));
 float3 tangent=cross(PatchV.xyz,normal);
 float det=dot(PatchU.xyz,tangent);
 if(abs(det)>1e-10) {
  tangent=normalize(tangent/det);
  float3 bitangent=normalize(cross(normal,PatchU.xyz)/det);
  float3 world=tangent*n.x+bitangent*n.y+normal*n.z;
  n=float3(dot(world,ChartU.xyz),dot(world,ChartV.xyz),dot(world,normal));
 }
 float4 mask=_MaskMap.SampleLevel(sampler_MaskMap,uv,mip);
 if(OriginalRoad!=0) {
  float2 world=mul(Frame,float4(position,1)).xz*WorldScale;
  float blend=mask.b;
  float4 wm=_WorldspaceMaskMap.SampleLevel(sampler_WorldspaceMaskMap,world,0);
  c=lerp(c,_WorldspaceAlbedo.SampleLevel(sampler_WorldspaceAlbedo,world,0),blend)*BaseColor;
  float3 wn=unpack(_WorldspaceNormalMap.SampleLevel(sampler_WorldspaceNormalMap,world,0));
  // The native blue mask identifies the asphalt layer, including parking and
  // empty lanes in mixed sections. Curbs and unsupported layers retain native UVs.
  if(ReplaceRoad!=0) {
   float2 q=frac(float2(dot(float4(position,1),RoadU),dot(float4(position,1),RoadV)));
   float along=RoadBandRows!=0?q.y:q.x;
   [loop]for(int band=0;band<RoadBandCount;band++) {
    float4 range=RoadBands[band*2], area=RoadBands[band*2+1];
    if(along<range.x || along>=range.y)continue;
    float2 tile=q;
    if(RoadBandRows!=0)tile.y=(along-range.x)/(range.y-range.x);
    else tile.x=(along-range.x)/(range.y-range.x);
    tile.y=frac(tile.y*range.z);
    float2 roadUV=area.xy+tile*area.zw;
    float4 roadColor=_Road_BaseColorMap.SampleLevel(sampler_Road_BaseColorMap,roadUV,0);
    // Replace only the worldspace layer; retain source atlas detail outside it.
    c=lerp(_BaseColorMap.SampleLevel(sampler_BaseColorMap,uv,mip)*BaseColor,roadColor,blend);
    wm=_Road_MaskMap.SampleLevel(sampler_Road_MaskMap,roadUV,0);
    float3 rn=unpack(_Road_NormalMap.SampleLevel(sampler_Road_NormalMap,roadUV,0));
    float3 rt=normalize(cross(RoadV.xyz,normal)/dot(RoadU.xyz,cross(RoadV.xyz,normal)));
    float3 rb=normalize(cross(normal,RoadU.xyz)/dot(RoadU.xyz,cross(RoadV.xyz,normal)));
    float3 rnormal=rt*rn.x+rb*rn.y+normal*rn.z;
    // Transform into the native worldspace normal frame used below.
    float3 rw=normalize(mul((float3x3)Frame,rnormal));
    wn=rw.xzy;
    break;
   }
  }
  float3 cu=normalize(mul((float3x3)Frame,ChartU.xyz));
  float3 cv=normalize(mul((float3x3)Frame,ChartV.xyz));
  float3 cn=normalize(mul((float3x3)Frame,normal));
  float3 worldNormal=float3(wn.x,wn.z,wn.y);
  n=normalize(lerp(n,float3(dot(worldNormal,cu),dot(worldNormal,cv),dot(worldNormal,cn)),blend));
  mask=float4(lerp(mask.rg,wm.rg,blend),0,lerp(mask.a,wm.a,blend));
  mask.r*=NativeValues.x; mask.a*=NativeValues.y;
 }
 AtlasColor[pixel]=float4(srgb(c.rgb),c.a);
 AtlasNormal[pixel]=float4(n.xy*.5+.5,1,1);
 AtlasMask[pixel]=mask;
 if(SkipAtlasControl==0) AtlasControl[pixel]=_ControlMask.SampleLevel(sampler_ControlMask,uv,mip);
}
[numthreads(8,8,1)] void PaintAtlas(uint3 id:SV_DispatchThreadID) {
 if(any(id.xy>=uint2(PaintRect.zw)))return;
 float2 local=id.xy+PaintRect.xy;
 uint2 pixel=uint2(local+AtlasRect.xy);
 float coverage=0;
 // Subpixel coverage prevents the hard staircase created by centre-only tests.
 [unroll]for(uint y=0;y<4;y++)[unroll]for(uint x=0;x<4;x++) {
  float3 delta=chartPosition(local+(float2(x,y)+.5)/4-.5)-PaintCenter.xyz;
  coverage+=(abs(dot(delta,PaintRight.xyz))<=PaintHalf.x && abs(dot(delta,PaintUp.xyz))<=PaintHalf.y && abs(dot(delta,PaintForward.xyz))<=PaintHalf.z)?1.0/16:0;
 }
 if(coverage==0)return;
 float4 c=_BaseColorMap.SampleLevel(sampler_BaseColorMap,PaintColor.xy,0);
 float4 old=AtlasColor[pixel];
 AtlasColor[pixel]=float4(srgb(lerp(linearColor(old.rgb),c.rgb,coverage)),lerp(old.a,1,coverage));
 float3 n=normalize(lerp(unpack(AtlasNormal[pixel]),float3(0,0,1),coverage));
 AtlasNormal[pixel]=float4(n.xy*.5+.5,1,1);
 AtlasMask[pixel]=lerp(AtlasMask[pixel],_MaskMap.SampleLevel(sampler_MaskMap,PaintColor.xy,0),coverage);
 AtlasControl[pixel]=lerp(AtlasControl[pixel],_ControlMask.SampleLevel(sampler_ControlMask,PaintColor.xy,0),coverage);
}
[numthreads(64,1,1)] void PreviewBounds(uint3 id:SV_DispatchThreadID) {
 if(id.x>=PreviewIndexCount)return;
 uint i=PreviewIndices[id.x];
 float3 p=mul(PreviewSkin[PreviewBones[i]],float4(PreviewPositions[i],1)).xyz;
 float3 q=mul(PreviewView,float4(p,1)).xyz;
 [unroll]for(uint k=0;k<3;k++) {
  uint a=orderedFloat(p[k]),b=orderedFloat(q[k]);
  InterlockedMin(PreviewExtents[k],a); InterlockedMax(PreviewExtents[k+3],a);
  InterlockedMin(PreviewExtents[k+6],b); InterlockedMax(PreviewExtents[k+9],b);
 }
}
