<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(CSII_MANAGEDPATH)</GameManagedDir>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/BridgeBuilder/Bridges/BridgePrototypeSource.cs" Link="BridgePrototypeSource.cs" />
    <Compile Include="../../src/BridgeBuilder/Bridges/BridgeStyleSources.cs" Link="BridgeStyleSources.cs" />
    <Reference Include="Colossal.PSI.Common"><HintPath>$(GameManagedDir)/Colossal.PSI.Common.dll</HintPath></Reference>
  </ItemGroup>
</Project>
